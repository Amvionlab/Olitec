# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser — never put secrets here.

# Public URL of this storefront (canonical URLs, sitemap.xml, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Shared backend API (the existing backend/ app, e-commerce module at /api/ecommerce)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Optional: API URL used by the Next.js server for server-rendered pages (e.g. an internal hostname).
# Defaults to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_BASE_URL=

# Where uploaded product images are served from (must match backend ECOM_MEDIA_BASE_URL); used to allow next/image.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000/api/ecommerce/media
