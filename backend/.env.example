# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
# Use 0.0.0.0 only when deploying behind a firewall/reverse proxy
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (3002 = e-commerce storefront)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# MySQL connection. When DB_USER and DB_PASSWORD are set, website warranty registrations, support tickets and
# service requests are saved to MySQL (run `npm run db:migrate`, then `npm run db:seed:dev` for the sample
# products and the demo customer). Without them the API serves mock data. DATA_SOURCE=mock forces mock data.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=warranty_db
DB_USER=warranty_app
DB_PASSWORD=change-me

# Session / token secrets (Phase 2 — must be long random values in production)
SESSION_SECRET=replace-with-a-long-random-string

# Warranty invoices and service-request photos are stored here (relative to backend/); never served publicly.
UPLOADS_DIR=uploads

# ---------------------------------------------------------------------------
# E-commerce module (/api/ecommerce) — uses the MySQL settings above.
# Run `npm run db:migrate` after filling in DB_*.
# ---------------------------------------------------------------------------
DB_POOL_SIZE=10
# Public storefront URL (password-reset links) and admin panel URL
ECOM_SITE_URL=http://localhost:3002
ECOM_ADMIN_URL=http://localhost:3001
# Uploaded product/banner images: folder (relative to backend/) and the public URL they are served from
ECOM_MEDIA_DIR=uploads/ecommerce
ECOM_MEDIA_BASE_URL=http://localhost:4000/api/ecommerce/media
# Session lifetimes
ECOM_CUSTOMER_SESSION_DAYS=7
ECOM_ADMIN_SESSION_HOURS=12
# Cookies: Secure is forced on in production. Set COOKIE_DOMAIN (e.g. .olitec.in) when the API and
# storefront run on different subdomains.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# How often unpaid checkout reservations are released (ms). 0 disables the sweep.
ECOM_RESERVATION_SWEEP_MS=60000

# Payments: razorpay | mock. "mock" simulates payments for local development and is REFUSED in production.
PAYMENT_PROVIDER=mock
# Razorpay keys (Dashboard → Settings → API Keys). Use rzp_test_ keys outside production. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Dashboard → Webhooks). Webhook URL: https://<api-host>/api/ecommerce/payments/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# Development seed (npm run db:seed:dev) — creates the first Super Admin. Refused in production.
SEED_ADMIN_EMAIL=admin@olitec.example
SEED_ADMIN_PASSWORD=
