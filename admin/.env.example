# Backend API base URL. Warranty screens still read mock data from src/mock; the E-Commerce screens call this API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# E-Commerce section (/ecommerce/*) — uses the REAL backend API above with a shop staff session cookie.
# Storefront URL, used for "View on shop" links from the product editor.
NEXT_PUBLIC_SHOP_URL=http://localhost:3002
